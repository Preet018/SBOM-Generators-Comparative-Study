<!-- Maven settings used only to resolve the dependency list of Jenkins' own published WAR pom
     (org.jenkins-ci.main:jenkins-war), which lives in the Jenkins repository, not Maven Central. -->
<settings>
  <profiles>
    <profile>
      <id>jenkins</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <repositories>
        <repository><id>repo.jenkins-ci.org</id><url>https://repo.jenkins-ci.org/public/</url></repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository><id>repo.jenkins-ci.org</id><url>https://repo.jenkins-ci.org/public/</url></pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
</settings>
